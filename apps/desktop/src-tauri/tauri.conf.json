{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Turing Core",
  "version": "0.1.0",
  "identifier": "dev.turingcore.ide",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Turing Core",
        "width": 1280,
        "height": 800,
        "minWidth": 680,
        "minHeight": 480,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; worker-src 'self'; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "devCsp": "default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; worker-src 'self'; connect-src ipc: http://ipc.localhost ws://127.0.0.1:1420; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "capabilities": [
        {
          "identifier": "workspace-editor",
          "description": "Scoped workspace and editor lifecycle commands for the local workbench.",
          "webviews": ["main", "workbench-*"],
          "permissions": [
            "allow-workspace-readonly",
            "allow-workspace-search",
            "allow-workspace-symbols",
            "allow-workspace-watch",
            "allow-workspace-edit",
            "allow-workspace-entry-mutations",
            "allow-editor-selected-files",
            "allow-interactive-terminal",
            "allow-git",
            "allow-run-build",
            "allow-managed-clangd",
            "allow-turing-windows",
            "allow-draft-recovery",
            "allow-ask"
          ]
        },
        {
          "identifier": "terminal-window",
          "description": "Manage PTYs owned by a dedicated local terminal window.",
          "webviews": ["terminal-*"],
          "permissions": ["allow-interactive-terminal"]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
